              "private",
              "all"
            ],
            "type": "string"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "scope": {
            "$ref": "#/$defs/Scope",
            "default": "all"
          }
        },
        "type": "object"
      },
      "name": "get_context",
      "outputSchema": {
        "$defs": {
          "Configuration": {
            "description": "Fully resolved configuration, with sources in increasing precedence order.",
            "properties": {
              "data_version": {
                "$ref": "#/$defs/DataVersion",
                "description": "Shared store version; user and private configuration cannot override it."
              },
              "format_version": {
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              },
              "sources": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "tags": {
                "$ref": "#/$defs/TagDefaults"
              },
              "upgrade": {
                "$ref": "#/$defs/UpgradeAdvice"
              },
              "upgrade_available": {
                "description": "Derived from the shared version; legacy stores remain readable and writable.",
                "type": "boolean"
              },
              "user_config_path": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "warnings": {
                "description": "Local advisory warnings. These never appear in shared/public configuration.",
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            },
            "required": [
              "format_version",
              "data_version",
              "upgrade_available",
              "upgrade",
              "warnings",
              "tags",
              "sources",
              "user_config_path"
            ],
            "type": "object"
          },
          "DataVersion": {
            "description": "Supported source formats for both public and private repository data.\nIndividual Markdown documents and disposable caches have no data version.",
            "oneOf": [
              {
                "const": "v1alpha1",
                "description": "Legacy format, also used when the shared field is absent.",
                "type": "string"
              },
              {
                "const": "v1alpha2",
                "description": "Explicit repository-wide version marker; Markdown layout is unchanged.",
                "type": "string"
              },
              {
                "const": "v1alpha3",
                "description": "Explicit migration repairs legacy YAML tag indentation without changing values.",
                "type": "string"
              },
              {
                "const": "v1alpha4",
                "description": "Tags use optional descriptions instead of required topics.",
                "type": "string"
              }
            ]
          },
          "Diagnostic": {
            "description": "A source problem surfaced without silently serving stale cached content.",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "visibility": {

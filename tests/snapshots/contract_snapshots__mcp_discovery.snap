    {
      "annotations": {
        "destructiveHint": false,
        "openWorldHint": false
      },
      "description": "Edit only specified fields. Use status=archived for resolved/obsolete notes\nand status=active to restore them. Private notes remain private; publishing\nis separate. expected_revision is required. On conflict, re-read and reconcile\nthe changes before retrying; there is no overwrite bypass.",
      "inputSchema": {
        "$defs": {
          "NoteStatus": {
            "description": "Notes can be archived without deleting their history.",
            "enum": [
              "active",
              "archived"
            ],
            "type": "string"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "body": {
            "type": [
              "string",
              "null"
            ]
          },
          "body_format": {
            "description": "Set an advisory string hint. Omit to preserve existing metadata exactly.",
            "type": [
              "string",
              "null"
            ]
          },
          "clear_body_format": {
            "default": false,
            "description": "Remove a string hint; conflicts with body_format. Non-string legacy values\nmust be reconciled in the source rather than overwritten by this interface.",
            "type": "boolean"
          },
          "expected_revision": {
            "description": "Required last-read revision. A stale value rejects the edit without changing sources.",
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "private": {
            "description": "True moves a public note into private storage. Publishing is separate.",
            "type": [
              "boolean",
              "null"
            ]
          },
          "status": {
            "anyOf": [
              {
                "$ref": "#/$defs/NoteStatus"
              },
              {
                "type": "null"
              }
            ]
          },
          "tags": {
            "items": {
              "type": "string"
            },
            "type": [
              "array",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "expected_revision"
        ],
        "type": "object"
      },
      "name": "update_note",
      "outputSchema": {
        "$defs": {
          "Note": {
            "description": "A note read from its authoritative Markdown file.",
            "properties": {
              "body": {
                "type": "string"
              },
              "created_at": {
                "type": "string"
              },
              "id": {
                "type": "string"
              },
              "metadata": {
                "additionalProperties": true,
                "description": "Additional YAML fields retained during edits.",
                "type": "object"
              },
              "path": {
                "description": "Path relative to `.robostickies`.",
                "type": "string"
              },
              "revision": {
                "description": "Content hash for optimistic concurrency checks.",
                "type": "string"
              },
              "status": {
                "$ref": "#/$defs/NoteStatus"
              },
              "tags": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "updated_at": {
                "type": "string"
              },
              "visibility": {
                "$ref": "#/$defs/Visibility",
                "description": "Computed from storage location and private tag references."
              }
            },
            "required": [
              "id",
              "created_at",
              "updated_at",
              "tags",
              "status",
              "body",
              "visibility",
              "revision",
              "path",
              "metadata"
            ],
            "type": "object"
          },
          "NoteStatus": {
            "description": "Notes can be archived without deleting their history.",
            "enum": [
              "active",
              "archived"
            ],
            "type": "string"
          },
          "Visibility": {
            "description": "Storage namespace. Public means eligible for sharing through Git.",
            "enum": [
              "public",
              "private"
            ],
            "type": "string"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "note": {
            "$ref": "#/$defs/Note"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "note",
          "warnings"
        ],
        "type": "object"
      }
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "description": "Explicitly upgrade the shared store data version for both namespaces.\nSet dry_run=true to preview, defer=true to decline the optional target, or\nkeep_snapshot=true to retain recovery data. Note values and customized guidance\nare preserved; repaired sources receive new revisions. Re-read before editing.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "defer": {
            "default": false,
            "description": "Remember a declined optional target without changing the store version.",
            "type": "boolean"
          },
          "dry_run": {
            "default": false,
            "type": "boolean"
          },
          "keep_snapshot": {
            "default": false,
            "description": "Retain the recovery snapshot after a successful migration.",
            "type": "boolean"
          }
        },
        "type": "object"
      },
      "name": "upgrade_store",
      "outputSchema": {
        "$defs": {
          "DataVersion": {
            "description": "Supported source formats for both public and private repository data.\nIndividual Markdown documents and disposable caches have no data version.",
            "oneOf": [
              {
                "const": "v1alpha1",
                "description": "Legacy format, also used when the shared field is absent.",
                "type": "string"
              },
              {
                "const": "v1alpha2",
                "description": "Explicit repository-wide version marker; Markdown layout is unchanged.",
                "type": "string"
              },
              {
                "const": "v1alpha3",
                "description": "Explicit migration repairs legacy YAML tag indentation without changing values.",
                "type": "string"
              },
              {
                "const": "v1alpha4",
                "description": "Tags use optional descriptions instead of required topics.",
                "type": "string"
              }
            ]
          },
          "SnapshotResult": {
            "description": "Location and final retention of an upgrade snapshot, relative to the repository.",
            "properties": {
              "path": {
                "type": "string"
              },
              "retained": {
                "type": "boolean"
              }
            },
            "required": [
              "path",
              "retained"
            ],
            "type": "object"
          },
          "UpgradeAdvice": {
            "description": "Structured guidance for explicit migrations. Public advice never uses private\npreferences; deferral only silences optional local reminders for one target.",
            "properties": {
              "can_upgrade": {
                "type": "boolean"
              },
              "deferred": {
                "type": "boolean"
              },
              "message": {
                "type": "string"
              },
              "requirement": {
                "$ref": "#/$defs/UpgradeRequirement"
              },
              "source_version": {
                "$ref": "#/$defs/DataVersion"
              },
              "target_version": {
                "$ref": "#/$defs/DataVersion"
              }
            },
            "required": [
              "source_version",
              "target_version",
              "requirement",
              "can_upgrade",
              "deferred",
              "message"
            ],
            "type": "object"
          },
          "UpgradeRequirement": {
            "description": "Strength of the recommendation, independent of a local deferral preference.",
            "enum": [
              "none",
              "should",
              "must"
            ],
            "type": "string"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "deferred": {
            "description": "True when this call recorded a declined optional target.",
            "type": "boolean"
          },
          "dry_run": {
            "description": "Whether the caller requested validation without a source save.",
            "type": "boolean"
          },
          "snapshot": {
            "anyOf": [
              {
                "$ref": "#/$defs/SnapshotResult"
              },
              {
                "type": "null"
              }
            ],
            "description": "Absent for previews, deferrals, and already-current stores."
          },
          "source_version": {
            "$ref": "#/$defs/DataVersion",
            "description": "Version read while holding the operation lock."
          },
          "target_version": {
            "$ref": "#/$defs/DataVersion",
            "description": "Application's current data version."
          },
          "upgrade": {
            "$ref": "#/$defs/UpgradeAdvice"
          },
          "warnings": {
            "description": "Local preference or snapshot-cleanup warnings; migration itself succeeded.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "wrote": {
            "description": "True only when this call saved the migrated shared configuration.",
            "type": "boolean"
          }
        },
        "required": [
          "source_version",
          "target_version",
          "wrote",
          "dry_run",
          "deferred",
          "upgrade",
          "snapshot",
          "warnings"
        ],
        "type": "object"
      }
    },
    {
      "annotations": {
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "description": "Diagnose invalid sources, unresolved tags, and Git tracking/exclusion problems.\nHealthy validation does not imply current data: inspect the separate upgrade advice.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "type": "object"
      },
      "name": "validate_store",
      "outputSchema": {
        "$defs": {
          "DataVersion": {
            "description": "Supported source formats for both public and private repository data.\nIndividual Markdown documents and disposable caches have no data version.",
            "oneOf": [
              {
                "const": "v1alpha1",
                "description": "Legacy format, also used when the shared field is absent.",
                "type": "string"
              },
              {
                "const": "v1alpha2",
                "description": "Explicit repository-wide version marker; Markdown layout is unchanged.",
                "type": "string"
              },
              {
                "const": "v1alpha3",
                "description": "Explicit migration repairs legacy YAML tag indentation without changing values.",
                "type": "string"
              },
              {
                "const": "v1alpha4",
                "description": "Tags use optional descriptions instead of required topics.",
                "type": "string"
              }
            ]
          },
          "Diagnostic": {
            "description": "A source problem surfaced without silently serving stale cached content.",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "visibility": {
                "$ref": "#/$defs/Visibility"
              }
            },
            "required": [
              "path",
              "code",
              "message",
              "visibility"
            ],
            "type": "object"
          },
          "UpgradeAdvice": {
            "description": "Structured guidance for explicit migrations. Public advice never uses private\npreferences; deferral only silences optional local reminders for one target.",
            "properties": {
              "can_upgrade": {
                "type": "boolean"
              },
              "deferred": {
                "type": "boolean"
              },
              "message": {
                "type": "string"
              },
              "requirement": {
                "$ref": "#/$defs/UpgradeRequirement"
              },
              "source_version": {
                "$ref": "#/$defs/DataVersion"
              },
              "target_version": {
                "$ref": "#/$defs/DataVersion"
              }
            },
            "required": [
              "source_version",
              "target_version",
              "requirement",
              "can_upgrade",
              "deferred",
              "message"
            ],
            "type": "object"
          },
          "UpgradeRequirement": {
            "description": "Strength of the recommendation, independent of a local deferral preference.",
            "enum": [
              "none",
              "should",
              "must"
            ],
            "type": "string"
          },
          "Visibility": {
            "description": "Storage namespace. Public means eligible for sharing through Git.",
            "enum": [
              "public",
              "private"
            ],
            "type": "string"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "data_version": {
            "$ref": "#/$defs/DataVersion"
          },
          "diagnostics": {
            "items": {
              "$ref": "#/$defs/Diagnostic"
            },
            "type": "array"
          },
          "healthy": {
            "type": "boolean"
          },
          "notes": {
            "format": "uint",
            "minimum": 0,
            "type": "integer"
          },
          "tags": {
            "format": "uint",
            "minimum": 0,
            "type": "integer"
          },
          "upgrade": {
            "$ref": "#/$defs/UpgradeAdvice"
          },
          "upgrade_available": {
            "type": "boolean"
          },
          "warnings": {
            "description": "Local advisory preference warnings, separate from source health.",
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "data_version",
          "upgrade_available",
          "upgrade",
          "warnings",
          "healthy",
          "notes",
          "tags",
          "diagnostics"
        ],
        "type": "object"
      }
    },
    {
      "annotations": {
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "description": "Identify this running process from compiled build data, without reading a store.\nUse this after installation: replacing the CLI does not refresh an existing MCP process.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "type": "object"
      },
      "name": "version",
      "outputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "commit": {
            "description": "Full source commit, or unknown when provenance is unavailable.",
            "type": "string"
          },
          "compiler": {
            "description": "Compiler version used to build this artifact.",
            "type": "string"
          },
          "name": {
            "description": "Compiled package name.",
            "type": "string"
          },
          "profile": {
            "description": "Cargo build profile.",
            "type": "string"
          },
          "source_state": {
            "description": "Tracked source state: clean, dirty, or unknown.",
            "type": "string"
          },
          "target": {
            "description": "Rust target triple.",
            "type": "string"
          },
          "version": {
            "description": "Compiled package SemVer.",
            "type": "string"
          }
        },
        "required": [
          "name",
          "version",
          "commit",
          "source_state",
          "target",
          "compiler",
          "profile"
        ],
        "type": "object"
      }
    }
  ]
}

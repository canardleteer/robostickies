      },
      "description": "Read complete guidance for a tag, using private:<name> for private definitions.\nThe optional description explains the name; body holds Markdown usage guidance.\nSelf-explanatory tags usually have no description (null).",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",

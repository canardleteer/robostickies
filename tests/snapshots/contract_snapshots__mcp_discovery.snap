---
source: tests/contract_snapshots.rs
expression: "json!({\"instructions\": instructions, \"tools\": tools, \"resources\": resources})"
---
{
  "instructions": "Call get_context at the start of work. Inspect upgrade.requirement and upgrade.message independently of healthy and diagnostics. Surface should recommendations unless upgrade.deferred is true; explain must requirements before ordinary work. Offer an explicit upgrade_store preview, upgrade, or deferral; never migrate automatically. Use version to identify this running MCP build. A newer CLI on disk does not refresh an existing server; use a fresh server before verifying changed behavior. Read tag names, optional descriptions, and full startup guidance. Record friction with papercut and useful successes with paperclip; other tags and general notes are welcome. Private tags use private:<name> and force ignored local storage. Public review includes only public notes; publish_note makes an explicit public copy. Read get_context for details and a portable AGENTS.md snippet. Use init_store if the repository is not initialized.",
  "resources": [
    {
      "description": "Local configuration defaults and their sources",
      "mimeType": "application/json",
      "name": "Effective configuration",
      "uri": "robostickies://config"
    },
    {
      "description": "Tag names, optional descriptions, startup guidance, and optional AGENTS.md paragraph",
      "mimeType": "application/json",
      "name": "Session context",
      "uri": "robostickies://context"
    },
    {
      "description": "How to record, discover, keep private, and publish notes",
      "mimeType": "application/json",
      "name": "Full guidance",
      "uri": "robostickies://guidance"
    },
    {
      "description": "Qualified tag names and optional descriptions; self-explanatory tags usually need none",
      "mimeType": "application/json",
      "name": "Tag catalog",
      "uri": "robostickies://tags"
    }
  ],
  "tools": [
    {
      "annotations": {
        "destructiveHint": false,
        "openWorldHint": false
      },
      "description": "Record a brief observation. Prefer papercut for friction and paperclip for\nconcrete wins; general notes are welcome. Any private:<tag> forces private\nstorage. Set private=true to keep any note local; omit to derive from tags.\nBodies are nonempty UTF-8 text; optional body_format is an advisory hint.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "body": {
            "description": "Nonempty UTF-8 text. Markdown or plain text is preferred.",
            "type": "string"
          },
          "body_format": {
            "description": "Advisory metadata.body_format; markdown, text, and yaml are recommended.\nOther nonblank strings are accepted without interpreting the body.",
            "type": [
              "string",
              "null"
            ]
          },
          "private": {
            "description": "Omit to derive privacy from tags. False cannot override a private tag.",
            "type": [
              "boolean",
              "null"
            ]
          },
          "tags": {
            "default": [],
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "body"
        ],
        "type": "object"
      },
      "name": "create_note",
      "outputSchema": {
        "$defs": {
          "Note": {
            "description": "A note read from its authoritative Markdown file.",
            "properties": {
              "body": {
                "type": "string"
              },
              "created_at": {
                "type": "string"
              },
              "id": {
                "type": "string"
              },
              "metadata": {
                "additionalProperties": true,
                "description": "Additional YAML fields retained during edits.",
                "type": "object"
              },
              "path": {
                "description": "Path relative to `.robostickies`.",
                "type": "string"
              },
              "revision": {
                "description": "Content hash for optimistic concurrency checks.",
                "type": "string"
              },
              "status": {
                "$ref": "#/$defs/NoteStatus"
              },
              "tags": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "updated_at": {
                "type": "string"
              },
              "visibility": {
                "$ref": "#/$defs/Visibility",
                "description": "Computed from storage location and private tag references."
              }
            },
            "required": [
              "id",
              "created_at",
              "updated_at",
              "tags",
              "status",
              "body",
              "visibility",
              "revision",
              "path",
              "metadata"
            ],
            "type": "object"
          },
          "NoteStatus": {
            "description": "Notes can be archived without deleting their history.",
            "enum": [
              "active",
              "archived"
            ],
            "type": "string"
          },
          "Visibility": {
            "description": "Storage namespace. Public means eligible for sharing through Git.",
            "enum": [
              "public",
              "private"
            ],
            "type": "string"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "note": {
            "$ref": "#/$defs/Note"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "note",
          "warnings"
        ],
        "type": "object"
      }
    },
    {
      "annotations": {
        "destructiveHint": false,
        "openWorldHint": false
      },
      "description": "Define a tag with a required bare name and optional description and Markdown guidance.\nSelf-explanatory tags usually do not need a description. Omit it or use null;\nblank descriptions are rejected. Usage instructions belong in body.\nName-only creation in legacy stores requires an explicit upgrade_store first.\nSet private=true/false to override configuration defaults and name patterns.\nPrivate tags have distinct private:<name> identities even if public names match.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "body": {
            "default": "",
            "description": "Optional Markdown usage instructions, separate from the catalog description.",
            "type": "string"
          },
          "description": {
            "description": "Optional short catalog explanation. Self-explanatory tags usually need none.\nOmit or use null for no description; blank text is invalid. Text is preserved.",
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "description": "Required bare filename slug, e.g. fresh-install; used as the note tag.",
            "type": "string"
          },
          "private": {
            "description": "Override configured privacy defaults; private tags use private:<name>.",
            "type": [
              "boolean",
              "null"
            ]
          },
          "read_on_start": {
            "default": false,
            "description": "Include the full guidance in startup context.",
            "type": "boolean"
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      },
      "name": "create_tag",
      "outputSchema": {
        "$defs": {
          "Visibility": {
            "description": "Storage namespace. Public means eligible for sharing through Git.",
            "enum": [
              "public",
              "private"
            ],
            "type": "string"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "body": {
            "description": "Optional Markdown usage instructions, separate from the description.",
            "type": "string"
          },
          "description": {
            "description": "Optional catalog explanation. Self-explanatory names usually need none.\nUsage instructions belong in `body`; absent descriptions serialize as null.",
            "type": [
              "string",
              "null"
            ]
          },
          "metadata": {
            "additionalProperties": true,
            "type": "object"
          },
          "name": {
            "description": "Scope-qualified name, e.g. `tooling` or `private:tooling`.",
            "type": "string"
          },
          "read_on_start": {
            "description": "Include this tag's complete guidance in session startup context.",
            "type": "boolean"
          },
          "revision": {
            "type": "string"
          },
          "visibility": {
            "$ref": "#/$defs/Visibility"
          }
        },
        "required": [
          "name",
          "description",
          "read_on_start",
          "body",
          "visibility",
          "revision",
          "metadata"
        ],
        "type": "object"
      }
    },
    {
      "annotations": {
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "description": "Inspect effective TOML configuration, privacy defaults, and their source files.\nRead upgrade.requirement/message/deferred and warnings for maintenance advice.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "type": "object"
      },
      "name": "get_config",
      "outputSchema": {
        "$defs": {
          "DataVersion": {
            "description": "Supported source formats for both public and private repository data.\nIndividual Markdown documents and disposable caches have no data version.",
            "oneOf": [
              {
                "const": "v1alpha1",
                "description": "Legacy format, also used when the shared field is absent.",
                "type": "string"
              },
              {
                "const": "v1alpha2",
                "description": "Explicit repository-wide version marker; Markdown layout is unchanged.",
                "type": "string"
              },
              {
                "const": "v1alpha3",
                "description": "Explicit migration repairs legacy YAML tag indentation without changing values.",
                "type": "string"
              },
              {
                "const": "v1alpha4",
                "description": "Tags use optional descriptions instead of required topics.",
                "type": "string"
              }
            ]
          },
          "TagDefaults": {
            "description": "Tag-creation defaults. Explicit creation arguments always take precedence.",
            "properties": {
              "default_private": {
                "default": false,
                "type": "boolean"
              },
              "private_patterns": {
                "default": [],
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            },
            "required": [
              "default_private",
              "private_patterns"
            ],
            "type": "object"
          },
          "UpgradeAdvice": {
            "description": "Structured guidance for explicit migrations. Public advice never uses private\npreferences; deferral only silences optional local reminders for one target.",
            "properties": {
              "can_upgrade": {
                "type": "boolean"
              },
              "deferred": {
                "type": "boolean"
              },
              "message": {
                "type": "string"
              },
              "requirement": {
                "$ref": "#/$defs/UpgradeRequirement"
              },
              "source_version": {
                "$ref": "#/$defs/DataVersion"
              },
              "target_version": {
                "$ref": "#/$defs/DataVersion"
              }
            },
            "required": [
              "source_version",
              "target_version",
              "requirement",
              "can_upgrade",
              "deferred",
              "message"
            ],
            "type": "object"
          },
          "UpgradeRequirement": {
            "description": "Strength of the recommendation, independent of a local deferral preference.",
            "enum": [
              "none",
              "should",
              "must"
            ],
            "type": "string"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "data_version": {
            "$ref": "#/$defs/DataVersion",
            "description": "Shared store version; user and private configuration cannot override it."
          },
          "format_version": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "sources": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "tags": {
            "$ref": "#/$defs/TagDefaults"
          },
          "upgrade": {
            "$ref": "#/$defs/UpgradeAdvice"
          },
          "upgrade_available": {
            "description": "Derived from the shared version; legacy stores remain readable and writable.",
            "type": "boolean"
          },
          "user_config_path": {
            "type": [
              "string",
              "null"
            ]
          },
          "warnings": {
            "description": "Local advisory warnings. These never appear in shared/public configuration.",
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "format_version",
          "data_version",
          "upgrade_available",
          "upgrade",
          "warnings",
          "tags",
          "sources",
          "user_config_path"
        ],
        "type": "object"
      }
    },
    {
      "annotations": {
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "description": "Call this at session start. Inspect upgrade.requirement, upgrade.message,\nupgrade.deferred and warnings even when validation is healthy. Then read tag\nnames, optional descriptions, and startup guidance. Also returns configuration\nand an AGENTS.md snippet.",
      "inputSchema": {
        "$defs": {
          "Scope": {
            "description": "Which namespaces a read operation may include.",

    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "description": "Rebuild the disposable Rust-native redb index from current Markdown sources.\nSource files and Git history remain intact.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "type": "object"
      },
      "name": "rebuild_index",
      "outputSchema": {
        "$defs": {
          "DataVersion": {
            "description": "Supported source formats for both public and private repository data.\nIndividual Markdown documents and disposable caches have no data version.",
            "oneOf": [
              {
                "const": "v1alpha1",
                "description": "Legacy format, also used when the shared field is absent.",
                "type": "string"
              },
              {
                "const": "v1alpha2",
                "description": "Explicit repository-wide version marker; Markdown layout is unchanged.",
                "type": "string"
              },
              {
                "const": "v1alpha3",
                "description": "Explicit migration repairs legacy YAML tag indentation without changing values.",
                "type": "string"
              },
              {
                "const": "v1alpha4",
                "description": "Tags use optional descriptions instead of required topics.",
                "type": "string"
              }
            ]
          },
          "Diagnostic": {
            "description": "A source problem surfaced without silently serving stale cached content.",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "visibility": {
                "$ref": "#/$defs/Visibility"
              }
            },
            "required": [
              "path",
              "code",
              "message",
              "visibility"
            ],
            "type": "object"
          },
          "UpgradeAdvice": {
            "description": "Structured guidance for explicit migrations. Public advice never uses private\npreferences; deferral only silences optional local reminders for one target.",
            "properties": {
              "can_upgrade": {
                "type": "boolean"
              },
              "deferred": {
                "type": "boolean"
              },
              "message": {
                "type": "string"
              },
              "requirement": {
                "$ref": "#/$defs/UpgradeRequirement"
              },
              "source_version": {
                "$ref": "#/$defs/DataVersion"
              },
              "target_version": {
                "$ref": "#/$defs/DataVersion"
              }
            },
            "required": [
              "source_version",
              "target_version",
              "requirement",
              "can_upgrade",
              "deferred",
              "message"
            ],
            "type": "object"
          },
          "UpgradeRequirement": {
            "description": "Strength of the recommendation, independent of a local deferral preference.",
            "enum": [
              "none",
              "should",
              "must"
            ],
            "type": "string"
          },
          "Visibility": {
            "description": "Storage namespace. Public means eligible for sharing through Git.",
            "enum": [
              "public",
              "private"
            ],
            "type": "string"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "data_version": {
            "$ref": "#/$defs/DataVersion"
          },
          "diagnostics": {
            "items": {
              "$ref": "#/$defs/Diagnostic"
            },
            "type": "array"
          },
          "healthy": {
            "type": "boolean"
          },
          "notes": {
            "format": "uint",
            "minimum": 0,
            "type": "integer"
          },
          "tags": {
            "format": "uint",
            "minimum": 0,
            "type": "integer"
          },
          "upgrade": {
            "$ref": "#/$defs/UpgradeAdvice"
          },
          "upgrade_available": {
            "type": "boolean"
          },
          "warnings": {
            "description": "Local advisory preference warnings, separate from source health.",
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "data_version",
          "upgrade_available",
          "upgrade",
          "warnings",
          "healthy",
          "notes",
          "tags",
          "diagnostics"
        ],
        "type": "object"
      }

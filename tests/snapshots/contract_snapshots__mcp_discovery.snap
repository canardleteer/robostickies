                "type": "string"
              },
              "description": {
                "description": "Optional catalog explanation. Self-explanatory names usually need none.\nUsage instructions belong in `body`; absent descriptions serialize as null.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "metadata": {
                "additionalProperties": true,
                "type": "object"
              },
              "name": {
                "description": "Scope-qualified name, e.g. `tooling` or `private:tooling`.",
                "type": "string"
              },
